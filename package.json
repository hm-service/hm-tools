{
  "name": "hm-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "jszip": "^3.10.2",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.3.4",
    "tweetnacl": "^1.0.3",
    "uqr": "^0.1.3",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tsconfig/node26": "^26.0.1",
    "@types/node": "^26.6.6",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.90.0",
    "eslint-plugin-vue": "~10.12.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.4",
    "oxlint": "~1.90.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@12.13.0"
